VITE_BLOCKS_API_URL=https://blocksapi.slsblx.com
# This project's tenant id. Sent as the x-blocks-key header on every
# Blocks API call, and as tenant_id on the OIDC login request -- both
# mean the same thing: which Blocks tenant this app belongs to.
VITE_BLOCKS_X_BLOCKS_KEY=D08e00d1169e543c9b2c2ac64060b9358
VITE_BLOCKS_APP_DOMAIN=https://dtdgmi-elgoe.slsblx.com
VITE_BLOCKS_OIDC_URL=https://iam.seliseblocks.com
# Public browser OIDC client (hosted IAM IdP flow, no secret). Register it in Blocks IAM
# with redirect_uris for both your dev origin and VITE_BLOCKS_APP_DOMAIN.
VITE_BLOCKS_OIDC_CLIENT_ID=c1a18c09-1e09-4a54-b499-443f3edcea30
VITE_BLOCKS_OIDC_SCOPE=openid profile
# Set to your project's real domain (Project/Gets -> applications[].domain,
# no scheme) to test OIDC login locally over HTTPS -- see README.md.
VITE_BLOCKS_DEV_HOST=dtdgmi-elgoe.slsblx.com
VITE_BLOCKS_DEV_PORT=5173

# ---------------------------------------------------------------------------
# Private API (app/server) — read from this same file by the server; these
# keys are NEVER exposed to the browser (only VITE_-prefixed values are).
# ---------------------------------------------------------------------------
# Assistant provider (optional; without all three, reviewed templates are used).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_ENABLED=false
# Exact browser origins allowed to call the private API, comma-separated.
APP_ORIGINS=https://localhost:5174,https://dtdgmi-elgoe.slsblx.com:5174
# Local API listener (production uses API_HOST=0.0.0.0, API_PORT=8080).
API_PORT=8787
API_HOST=127.0.0.1
# Least-privilege Blocks machine client for patient lookup and notifications.
# Leave empty to disable the worker and fail closed on patient ticket reads.
BLOCKS_SERVICE_CLIENT_ID=
BLOCKS_SERVICE_CLIENT_SECRET=
BLOCKS_SERVICE_SCOPE=
DEADLINE_WARNING_HOURS=24
# Required in production: base64-encoded 32 random bytes, held in a secret manager.
PAYOUT_ENCRYPTION_KEY=
# Production: a persistent private volume, never inside the frontend/public directory.
PRIVATE_DATA_DIR=
